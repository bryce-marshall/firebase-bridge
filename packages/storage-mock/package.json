{
  "name": "@firebase-bridge/storage-mock",
  "version": "0.0.2",
  "private": true,
  "license": "Apache-2.0",
  "description": "In-memory Cloud Storage mock and trigger harness for Firebase Bridge.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "nx build storage-mock",
    "build:esm": "nx run storage-mock:build-esm",
    "build:cjs": "nx run storage-mock:build-cjs",
    "prepublishOnly": "nx build storage-mock && node ../../tools/prepare-publish.mjs",
    "publish:pkg": "npm publish ./dist --access public",
    "pack:dry": "npm pack ./dist --dry-run"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/esm/index.d.ts",
        "require": "./dist/esm/index.d.cts"
      },
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./v1": {
      "types": {
        "import": "./dist/esm/lib/v1/index.d.ts",
        "require": "./dist/esm/lib/v1/index.d.cts"
      },
      "import": "./dist/esm/lib/v1/index.js",
      "require": "./dist/cjs/lib/v1/index.js"
    },
    "./v2": {
      "types": {
        "import": "./dist/esm/lib/v2/index.d.ts",
        "require": "./dist/esm/lib/v2/index.d.cts"
      },
      "import": "./dist/esm/lib/v2/index.js",
      "require": "./dist/cjs/lib/v2/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "v1": [
        "dist/esm/lib/v1/index.d.ts"
      ],
      "v2": [
        "dist/esm/lib/v2/index.d.ts"
      ]
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@firebase-bridge/cloud-storage": "0.0.2"
  },
  "peerDependencies": {
    "firebase-functions": "^6.4.0 || ^7.0.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "cloud-storage-test-suites": "0.0.1",
    "typescript": ">=5.5 <6",
    "@types/node": "^20.0.0"
  },
  "nx": {
    "targets": {
      "build-esm": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -p build.esm.tsconfig.json --pretty false",
          "cwd": "{projectRoot}"
        },
        "outputs": [
          "{projectRoot}/dist/esm"
        ]
      },
      "build-cjs": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build-cjs"
        ],
        "options": {
          "command": "npx tsc -p build.cjs.tsconfig.json --pretty false",
          "cwd": "{projectRoot}"
        },
        "outputs": [
          "{projectRoot}/dist/cjs"
        ]
      },
      "post-build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build-esm"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "node .scripts/post-build.mjs"
        },
        "outputs": [
          "{projectRoot}/dist/package.json"
        ]
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "nx run storage-mock:clean",
            "nx run storage-mock:build-esm",
            "nx run storage-mock:build-cjs",
            "nx run storage-mock:post-build"
          ],
          "parallel": false
        },
        "outputs": [
          "{projectRoot}/dist/esm",
          "{projectRoot}/dist/cjs"
        ]
      }
    }
  }
}
